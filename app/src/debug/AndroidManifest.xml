<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay.

  Allows cleartext traffic so `adb reverse tcp:3000 tcp:3000` (plus
  tcp:3001 for the dial WebSocket) can exercise the complete desktop →
  socket → authoritative read → ACTION_DIAL pipeline against a local
  backend. WacrmApi / DialSocketProtocol still accept cleartext only
  for loopback hosts and only when BuildConfig.DEBUG is true, so this
  does not weaken a release build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
